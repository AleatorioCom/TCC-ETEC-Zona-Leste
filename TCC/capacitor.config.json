{
  "appId": "br.com.etec.arvores",
  "appName": "Sementes Digitais",
  "webDir": "app",
  "backgroundColor": "#f4f6f2",
  "zoomEnabled": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#145324",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "autoBackdropColor": "auto"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#145324",
      "overlaysWebView": false
    }
  }
}
